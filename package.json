{
  "name": "@danilah/mini-games-kit",
  "version": "0.2.0-experimental.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./feel": {
      "types": "./dist/feel/index.d.ts",
      "import": "./dist/feel/index.js"
    },
    "./audio": {
      "types": "./dist/audio/index.d.ts",
      "import": "./dist/audio/index.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "import": "./dist/platform/index.js"
    },
    "./yandex": {
      "types": "./dist/yandex/index.d.ts",
      "import": "./dist/yandex/index.js"
    },
    "./yandex-tooling": {
      "types": "./dist/yandex-tooling/index.d.ts",
      "import": "./dist/yandex-tooling/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js"
    },
    "./phaser": {
      "types": "./dist/phaser/index.d.ts",
      "import": "./dist/phaser/index.js"
    },
    "./assets": {
      "types": "./dist/assets/index.d.ts",
      "import": "./dist/assets/index.js"
    },
    "./runtime-assets": {
      "types": "./dist/runtime-assets/index.d.ts",
      "import": "./dist/runtime-assets/index.js"
    },
    "./startup": {
      "types": "./dist/startup/index.d.ts",
      "import": "./dist/startup/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "pack:check": "npm pack --dry-run",
    "bootstrap:create": "node tools/bootstrap/create-yandex-phaser.mjs",
    "bootstrap:check": "node tools/bootstrap/validate-yandex-phaser.mjs",
    "bootstrap:smoke": "node tools/bootstrap/smoke-yandex-phaser.mjs"
  },
  "peerDependencies": {
    "phaser": "4.2.1",
    "sharp": ">=0.35.0"
  },
  "peerDependenciesMeta": {
    "phaser": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "phaser": "4.2.1",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}

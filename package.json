{
  "name": "@danilah/mini-games-kit",
  "version": "0.1.0-experimental.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",

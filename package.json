    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./feel": {
      "types": "./dist/feel/index.d.ts",
      "import": "./dist/feel/index.js"
    },
    "./phaser": {
      "types": "./dist/phaser/index.d.ts",
